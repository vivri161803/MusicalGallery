---
import { siteConfig } from '../config';
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = siteConfig.title } = Astro.props;

// Se lo scroll snap è abilitato da configurazione, forziamo il body a h-screen e applichiamo lo snap
const snapClass = siteConfig.layout.scrollSnap ? 'h-screen overflow-y-scroll snap-y snap-mandatory' : 'min-h-screen overflow-x-hidden';
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={siteConfig.description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class={`bg-apple-dark text-apple-text font-sans antialiased selection:bg-white selection:text-black ${snapClass}`}>
		<main class="relative z-10 w-full h-full">
			<slot />
		</main>
	</body>
</html>
